meta {
  name: 09 Get Order
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/orders/{{orderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("found with lines", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.total).to.equal(110);
    expect(res.body.data.lines.length).to.equal(2);
  });
}
