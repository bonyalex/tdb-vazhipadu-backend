meta {
  name: 10 Place Order - Inactive Offering (409)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

body:json {
  {
    "templeId": {{templeId}},
    "devoteeName": "Anil Kumar",
