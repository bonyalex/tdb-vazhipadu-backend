    "nakshatra": "ROHINI",
    "orderDate": "{{orderDate}}",
    "lines": [
      { "offeringId": {{inactiveOfferingId}}, "quantity": 1 }
    ]
  }
}

tests {
  test("rejected", function () {
    expect(res.status).to.equal(409);
    expect(res.body.status).to.equal(409);
  });
}
