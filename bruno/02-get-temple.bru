meta {
  name: 02 Get Temple
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/temples/{{templeId}}
  body: none
  auth: none
}

tests {
  test("found", function () {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.status).to.equal(200);
    expect(res.body.error).to.equal(null);
    expect(res.body.data.name).to.equal("Sree Temple");
  });
}
