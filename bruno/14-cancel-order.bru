meta {
  name: 14 Cancel Order
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/api/orders/{{orderId}}/cancel
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

tests {
  test("cancelled", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("CANCELLED");
  });
}
