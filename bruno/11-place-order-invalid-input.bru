meta {
  name: 11 Place Order - Invalid Input (400)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

body:json {
  {
    "templeId": {{templeId}},
    "devoteeName": "",
    "devoteePhone": "12345",
    "nakshatra": "ROHINI",
    "orderDate": "{{orderDate}}",
    "lines": [
      { "offeringId": {{archanaId}}, "quantity": 0 }
    ]
  }
}

tests {
  test("validation error shape", function () {
    expect(res.status).to.equal(400);
    expect(res.body.message).to.equal("Validation failed");
    expect(res.body.details.length).to.be.greaterThan(0);
  });
}
