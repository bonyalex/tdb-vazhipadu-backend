meta {
  name: 16 Collection Report - After Cancel
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/temples/{{templeId}}/collection?date={{orderDate}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{authToken}}
}

script:pre-request {
  if (!bru.getVar("orderDate")) {
    const tomorrow = new Date(Date.now() + 24 * 60 * 60 * 1000);
    bru.setVar("orderDate", tomorrow.toISOString().slice(0, 10));
  }
}

tests {
  test("cancelled order is not counted", function () {
    expect(res.status).to.equal(200);
    expect(res.body.data.totalCount).to.equal(0);
    expect(res.body.data.totalAmount).to.equal(0);
    expect(res.body.data.offerings.length).to.equal(0);
  });
}
